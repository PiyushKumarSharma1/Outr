# Optional source-level bridge to a local OutreachOS checkout.
# If absent, the bridge auto-discovers a sibling Documents/OPENCODE_PROJECTS/OutreachOS checkout for local development.
# OUTREACHOS_ROOT=/absolute/path/to/OutreachOS
# OUTREACHOS_PYTHON=/absolute/path/to/OutreachOS/.venv/bin/python
# OUTREACHOS_DB=/absolute/path/to/OutreachOS/outreachos.db
# Read operations are enabled when the source is present. Cycle execution is off by default.
OUTREACHOS_BRIDGE_WRITE_ENABLED=false
# Set true to allow POST /v1/integrations/outreachos/campaigns/:campaign/cycle.
# The Python engine is loaded fresh for each bridge request, so source and SQLite updates are picked up without restarting Outr.
